{
  "name": "kriti-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --external:googleapis --external:google-auth-library --external:jose --external:cookie --external:@vercel/node --outfile=api/index.js",
    "build": "tsc && vite build && npm run build:server",
    "build:pages": "tsc && vite build --base=/krititracker/",
    "lint": "tsc --noEmit",
    "preview": "vite preview --base=/krititracker/",
    "setup-sheets": "tsx scripts/setup-sheets.ts",
    "verify-connection": "tsx scripts/verify-connection.ts",
    "test:dev-login": "tsx scripts/test-dev-login.ts",
    "generate-icons": "tsx scripts/generate-pwa-icons.ts",
    "generate-og": "tsx scripts/generate-og-images.ts",
    "test:phase15": "tsx scripts/test-phase15.ts",
    "test:phase20": "tsx scripts/test-phase20.ts",
    "test:phase24": "tsx scripts/test-phase24.ts"
  },
  "dependencies": {
    "@react-oauth/google": "^0.12.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cookie": "^0.6.0",
    "date-fns": "^3.6.0",
    "google-auth-library": "^9.7.0",
    "googleapis": "^134.0.0",
    "jose": "^5.2.3",
    "lucide-react": "^0.359.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vercel/node": "^3.0.24",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.35",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
