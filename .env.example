# ==============================================================================
# KRITI Tracker - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local testing, or configure in Vercel Project Settings.
# NEVER commit real credentials or private keys to version control!

# ------------------------------------------------------------------------------
# 1. Google OAuth 2.0 Credentials (Authentication)
# ------------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# 2. Google Cloud Service Account (Google Sheets API Integration)
# ------------------------------------------------------------------------------
# From Google Cloud Console -> IAM & Admin -> Service Accounts -> Create Key (JSON)
# Share all 13 Google Spreadsheets with this service account email with "Editor" role.
GOOGLE_SERVICE_ACCOUNT_EMAIL="kriti-sheets-sa@your-gcp-project.iam.gserviceaccount.com"

# The private key from the JSON key file. Ensure newlines (\n) are preserved or properly escaped.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6...\n-----END PRIVATE KEY-----\n"

# Optional alternative: Base64-encoded complete Service Account JSON file (useful for Vercel multiline avoidance)
# GOOGLE_SERVICE_ACCOUNT_KEY_BASE64="eyd0eXBlJzonc2VydmljZV9hY2NvdW50Jy4uLn0="

# ------------------------------------------------------------------------------
# 3. Google Spreadsheets Identifiers (Primary Database)
# ------------------------------------------------------------------------------
# The Master Spreadsheet containing: Team_Overview, Users, Global_Activity
MASTER_SPREADSHEET_ID="1aBcDeFgHiJkLmNoPqRsTuVwXyZ_MasterSheetId"

# JSON string mapping Team IDs to their respective Google Spreadsheet IDs:
# Format: {"team-01":"ID_1","team-02":"ID_2", ... ,"team-12":"ID_12"}
TEAM_SPREADSHEET_IDS='{
  "team-01": "1Team01SpreadsheetIdExample11111111111111111111",
  "team-02": "1Team02SpreadsheetIdExample22222222222222222222",
  "team-03": "1Team03SpreadsheetIdExample33333333333333333333",
  "team-04": "1Team04SpreadsheetIdExample44444444444444444444",
  "team-05": "1Team05SpreadsheetIdExample55555555555555555555",
  "team-06": "1Team06SpreadsheetIdExample66666666666666666666",
  "team-07": "1Team07SpreadsheetIdExample77777777777777777777",
  "team-08": "1Team08SpreadsheetIdExample88888888888888888888",
  "team-09": "1Team09SpreadsheetIdExample99999999999999999999",
  "team-10": "1Team10SpreadsheetIdExample10101010101010101010",
  "team-11": "1Team11SpreadsheetIdExample11111111111111111112",
  "team-12": "1Team12SpreadsheetIdExample12121212121212121212"
}'

# ------------------------------------------------------------------------------
# 4. Security & Server Session Management
# ------------------------------------------------------------------------------
# Strong random 32+ character string used to sign HTTP-only session cookies
SESSION_SECRET="generate-a-strong-32-byte-hex-or-base64-random-session-secret"

# Initial Bootstrap Super Admin Email:
# When bootstrapping, if the Users sheet is empty, this user is automatically granted Super Admin.
INITIAL_ADMIN_EMAIL="admin@yourcompany.com"

# Application Base URL (e.g. http://localhost:5173 for local, https://kriti-tracker.vercel.app for production)
APP_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# 5. Local QA & Testing Auth Bypass (Zero-Leak Dev Mode)
# ------------------------------------------------------------------------------
# Set to "true" to enable 1-click test personas on the Login page for local testing
# and automated QA without requiring live Google OAuth credentials.
# In production builds (`npm run build`), this is strictly gated and dead-code eliminated.
VITE_ENABLE_DEV_LOGIN="true"
ENABLE_DEV_LOGIN="true"
